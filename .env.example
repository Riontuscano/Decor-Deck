# Stripe secret key (sk_test_... for development, sk_live_... in production)
STRIPE_API=
# Clerk keys from https://dashboard.clerk.com (API keys page). Checkout requires sign-in.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Google Gemini API key for the chatbot
GEMINI_API_KEY=
# Optional: Gemini model name
GEMINI_MODEL=gemini-2.5-flash
# Optional: public URL of the site, used for Stripe redirects and product images.
# On Render this defaults to RENDER_EXTERNAL_URL; locally it falls back to the request host.
PUBLIC_URL=
# development shows chatbot error details in API responses
NODE_ENV=development
